{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM Template for Assignment 4 - Azure Data Pipeline",
    "author": "Ashmit Gupta",
    "createdDate": "2026-06-15"
  },
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-superstore-pipeline",
      "metadata": {
        "description": "Name of the Resource Group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus",
      "allowedValues": ["eastus", "westus2", "centralus", "southeastasia", "westeurope"],
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "stashmitsuperstore01",
      "metadata": {
        "description": "Name of the Storage Account (must be globally unique, lowercase, 3-24 chars)"
      }
    },
    "dataFactoryName": {
      "type": "string",
      "defaultValue": "adf-ashmit-superstore",
      "metadata": {
        "description": "Name of the Azure Data Factory instance"
      }
    },
    "sourceBlobContainerName": {
      "type": "string",
      "defaultValue": "source-data",
      "metadata": {
        "description": "Blob container for source CSV files"
      }
    },
    "destinationBlobContainerName": {
      "type": "string",
      "defaultValue": "destination-data",
      "metadata": {
        "description": "Blob container for pipeline output / destination files"
      }
    }
  },
  "variables": {
    "storageAccountSku": "Standard_LRS",
    "storageAccountKind": "StorageV2",
    "adfIdentityType": "SystemAssigned",
    "storageBlobDataContributorRoleId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "roleAssignmentName": "[guid(resourceGroup().id, 'adf-storage-role')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Project": "Assignment-4",
        "Author": "Ashmit Gupta",
        "Purpose": "Superstore Data Pipeline"
      },
      "sku": {
        "name": "[variables('storageAccountSku')]"
      },
      "kind": "[variables('storageAccountKind')]",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "networkAcls": {
          "defaultAction": "Allow",
          "bypass": "AzureServices"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default/', parameters('sourceBlobContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None",
        "metadata": {
          "purpose": "Source container for raw Superstore CSV data",
          "createdBy": "Ashmit Gupta"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default/', parameters('destinationBlobContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None",
        "metadata": {
          "purpose": "Destination container for processed pipeline output",
          "createdBy": "Ashmit Gupta"
        }
      }
    },
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[parameters('dataFactoryName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Project": "Assignment-4",
        "Author": "Ashmit Gupta",
        "Purpose": "Superstore Data Pipeline Orchestration"
      },
      "identity": {
        "type": "[variables('adfIdentityType')]"
      },
      "properties": {
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleAssignmentName')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), '2018-06-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "storageAccountConnectionString": {
      "type": "string",
      "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01').keys[0].value)]"
    },
    "dataFactoryName": {
      "type": "string",
      "value": "[parameters('dataFactoryName')]"
    },
    "dataFactoryPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), '2018-06-01', 'Full').identity.principalId]"
    },
    "sourceBlobContainerUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('storageAccountName'), '.blob.core.windows.net/', parameters('sourceBlobContainerName'))]"
    },
    "destinationBlobContainerUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('storageAccountName'), '.blob.core.windows.net/', parameters('destinationBlobContainerName'))]"
    }
  }
}
